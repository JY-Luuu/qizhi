{
  "manifest_version": 3,
  "name": "栖纸 Qizhi",
  "version": "0.2.0",
  "description": "把当前网页的标题、链接和画面晾起来；视频自动裁出播放器。",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging",
    "contextMenus"
  ],
  "action": {
    "default_title": "把这一页晾起来",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
